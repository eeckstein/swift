// CHECK-LABEL: sil [ossa] @dont_sink_into_other_loop :
// CHECK:       bb1:
// CHECK-NEXT:    cond_br undef, bb2, bb3
// CHECK:       bb3:
// CHECK-NEXT:    pointer_to_address
// CHECK-NEXT:    index_addr
// CHECK-NEXT:    br bb4
// CHECK:       } // end sil function 'dont_sink_into_other_loop'
sil [ossa] @dont_sink_into_other_loop : $@convention(thin) (Builtin.RawPointer, Builtin.Word) -> () {
bb0(%0 : $Builtin.RawPointer, %1 : $Builtin.Word):
  %2 = pointer_to_address %0 to [strict] $*Int
  br bb1

bb1:
  %3 = index_addr %2, %1
  cond_br undef, bb2, bb3

bb2:
  br bb1

bb3:
  br bb4

bb4:
  %4 = load [trivial] %3
  cond_br undef, bb5, bb6

bb5:
  br bb4

bb6:
  %r = tuple ()
  return %r
}
