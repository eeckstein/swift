}

// CHECK-LABEL: sil [ossa] @sink_out_of_loop :
// CHECK:       bb1:
// CHECK-NEXT:    cond_br undef, bb2, bb3
// CHECK:       bb3:
// CHECK-NEXT:    pointer_to_address
// CHECK-NEXT:    index_addr
// CHECK-NEXT:    load [trivial]
// CHECK:       } // end sil function 'sink_out_of_loop'
sil [ossa] @sink_out_of_loop : $@convention(thin) (Builtin.RawPointer, Builtin.Word) -> () {
bb0(%0 : $Builtin.RawPointer, %1 : $Builtin.Word):
  %2 = pointer_to_address %0 to [strict] $*Int
  br bb1

bb1:
  %3 = index_addr %2, %1
  cond_br undef, bb2, bb3

bb2:
  br bb1

bb3:
  %4 = load [trivial] %3
  %r = tuple ()
  return %r
