// RUN: %target-sil-opt -store-and-borrow-optimization %s | %FileCheck %s

sil_stage canonical

import Builtin
import Swift


class C {
  @_hasStorage let i: Int
}

// CHECK-LABEL: sil [ossa] @store_and_borrow :
// CHECK:         %2 = begin_borrow %0
// CHECK:         %3 = ref_element_addr %2
// CHECK:         end_borrow %2
// CHECK:         return %0
// CHECK:       } // end sil function 'store_and_borrow'
sil [ossa] @store_and_borrow : $@convention(thin) (@owned C) -> @owned C {
bb0(%0 : @owned $C):
  %1 = alloc_stack $C
  %2 = store_and_borrow %0 to %1
  %3 = ref_element_addr %2, #C.i
  %4 = load [trivial] %3
  fix_lifetime %4
  %6 = end_borrow_and_take %2 from %1
  dealloc_stack %1
  return %6
}

// CHECK-LABEL: sil [ossa] @load_borrow :
// CHECK:         %1 = load [take] %0
// CHECK:         %2 = begin_borrow %1
// CHECK:         %3 = ref_element_addr %2
// CHECK:         end_borrow %2
// CHECK:         return %1
// CHECK:       } // end sil function 'load_borrow'
sil [ossa] @load_borrow : $@convention(thin) (@in C) -> @owned C {
bb0(%0 : $*C):
  %1 = load_borrow %0
  %2 = ref_element_addr %1, #C.i
  %3 = load [trivial] %2
  fix_lifetime %3
  %5 = end_borrow_and_take %1 from %0
  return %5
}

// CHECK-LABEL: sil [ossa] @phi_arguments :
// CHECK:       bb1:
// CHECK-NEXT:    [[BB1:%.*]] = begin_borrow %0
// CHECK-NEXT:    br bb3([[BB1]], %0)
// CHECK:       bb2:
// CHECK-NEXT:    [[BB2:%.*]] = begin_borrow %0
// CHECK-NEXT:    br bb3([[BB2]], %0)
// CHECK:       bb3([[RB1:%.*]] : @reborrow $C, [[A1:%.*]] : @owned $C):
// CHECK-NEXT:    [[BF1:%.*]] = borrowed [[RB1]] from ([[A1]])
// CHECK-NEXT:    br bb4([[BF1]], [[A1]])
// CHECK:       bb4([[RB2:%.*]] : @reborrow $C, [[A2:%.*]] : @owned $C):
// CHECK-NEXT:    [[BF2:%.*]] = borrowed [[RB2]] from ([[A2]])
// CHECK-NEXT:    ref_element_addr [[BF2]]
// CHECK:         return [[A2]]
// CHECK:       } // end sil function 'phi_arguments'
sil [ossa] @phi_arguments : $@convention(thin) (@owned C) -> @owned C {
bb0(%0 : @owned $C):
  %1 = alloc_stack $C
  cond_br undef, bb1, bb2

bb1:
  %3 = store_and_borrow %0 to %1
  br bb3(%3)

bb2:
  %5 = store_and_borrow %0 to %1
  br bb3(%5)

bb3(%7 : @reborrow $C):
  %8 = borrowed %7 from ()
  br bb4(%8)

bb4(%10 : @reborrow $C):
  %11 = borrowed %10 from ()
  %12 = ref_element_addr %11, #C.i
  %13 = load [trivial] %12
  fix_lifetime %13
  %15 = end_borrow_and_take %11 from %1
  dealloc_stack %1
  return %15
}

