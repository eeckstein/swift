// RUN: %empty-directory(%t)
// RUN: split-file %s %t
// RUN: %target-swift-frontend -emit-module -O -wmo -parse-as-library -module-name Lib -emit-module-path %t/Lib.swiftmodule %t/Lib.swift
// RUN: %target-sil-opt -I %t -enable-sil-verify-all -lower-aggregate-destroys %t/main.sil | %FileCheck %s

// Check that LowerAggregateDestroys does not destroy a field directly when the field's type
// has a deinit and metadata the client cannot access.

//--- Lib.swift

struct Inner: ~Copyable {
  let p: UnsafeMutablePointer<Int>
  init() { p = .allocate(capacity: 1) }
  deinit { p.deallocate() }
}

public struct Manager: ~Copyable {
  var inner: Inner
  public init() { inner = Inner() }
}

//--- main.sil

sil_stage canonical

import Builtin
import Swift
import Lib

struct Wrapper: ~Copyable {
  var m: Manager
  var n: Int
}

// CHECK-LABEL: sil [ossa] @destroyManager :
// CHECK-NOT:     destructure_struct
// CHECK:         destroy_value %0
// CHECK:       } // end sil function 'destroyManager'
sil [ossa] @destroyManager : $@convention(thin) (@owned Manager) -> () {
bb0(%0 : @owned $Manager):
  destroy_value %0
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @destroyWrapper :
// CHECK-NOT:     destructure_struct
// CHECK:         destroy_value %0
// CHECK:       } // end sil function 'destroyWrapper'
sil [ossa] @destroyWrapper : $@convention(thin) (@owned Wrapper) -> () {
bb0(%0 : @owned $Wrapper):
  destroy_value %0
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @destroyTupleWithManager :
// CHECK:         ({{%.*}}, [[M:%.*]]) = destructure_tuple %0
// CHECK-NOT:     destructure_struct
// CHECK:         destroy_value [[M]]
// CHECK:       } // end sil function 'destroyTupleWithManager'
sil [ossa] @destroyTupleWithManager : $@convention(thin) (@owned (Int, Manager)) -> () {
bb0(%0 : @owned $(Int, Manager)):
  destroy_value %0
  %r = tuple ()
  return %r
}
