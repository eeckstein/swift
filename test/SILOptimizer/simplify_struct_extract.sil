// RUN: %target-sil-opt -enable-sil-verify-all %s -onone-simplification -simplify-instruction=struct_extract | %FileCheck %s


import Swift
import Builtin

struct S {
  var a: String
  var b: String
}

// CHECK-LABEL: sil @struct_extract_first_field
// CHECK:         return %0
// CHECK:       } // end sil function 'struct_extract_first_field'
sil @struct_extract_first_field : $@convention(thin) (@owned String, @guaranteed String) -> @owned String {
bb0(%0 : $String, %1 : $String):
  %2 = struct $S (%0 : $String, %1 : $String)
  %3 = struct_extract %2 : $S, #S.a
  return %3 : $String
}

// CHECK-LABEL: sil @struct_extract_second_field
// CHECK:         return %1
// CHECK:       } // end sil function 'struct_extract_second_field'
sil @struct_extract_second_field : $@convention(thin) (@guaranteed String, @owned String) -> @owned String {
bb0(%0 : $String, %1 : $String):
  %2 = struct $S (%0 : $String, %1 : $String)
  %3 = struct_extract %2 : $S, #S.b
  return %3 : $String
}

// CHECK-LABEL: sil [ossa] @struct_extract_ossa
// CHECK:         %2 = copy_value %0
// CHECK:         return %2
// CHECK:       } // end sil function 'struct_extract_ossa'
sil [ossa] @struct_extract_ossa : $@convention(thin) (@guaranteed String, @guaranteed String) -> @owned String {
bb0(%0 : @guaranteed $String, %1 : @guaranteed $String):
  %2 = struct $S (%0 : $String, %1 : $String)
  %3 = struct_extract %2 : $S, #S.a
  %4 = copy_value %3 : $String
  return %4 : $String
}


struct IntAndString {
  var i: Int
  var s: String
}

// CHECK-LABEL: sil [ossa] @struct_extract_of_borrowed_struct_none_field :
// CHECK:         [[B:%.*]] = begin_borrow
// CHECK-NOT:     struct_extract
// CHECK:         end_borrow [[B]]
// CHECK:         return %0
// CHECK:       } // end sil function 'struct_extract_of_borrowed_struct_none_field'
sil [ossa] @struct_extract_of_borrowed_struct_none_field : $@convention(thin) (Int, @owned String) -> Int {
bb0(%0 : $Int, %1 : @owned $String):
  %2 = struct $IntAndString (%0 : $Int, %1 : $String)
  %3 = begin_borrow %2 : $IntAndString
  %4 = struct_extract %3 : $IntAndString, #IntAndString.i
  end_borrow %3 : $IntAndString
  destroy_value %2 : $IntAndString
  return %4 : $Int
}

// CHECK-LABEL: sil [ossa] @struct_extract_of_borrowed_struct_owned_field :
// CHECK:         [[B:%.*]] = begin_borrow
// CHECK:         [[E:%.*]] = struct_extract [[B]], #IntAndString.s
// CHECK:         copy_value [[E]]
// CHECK:       } // end sil function 'struct_extract_of_borrowed_struct_owned_field'
sil [ossa] @struct_extract_of_borrowed_struct_owned_field : $@convention(thin) (Int, @owned String) -> @owned String {
bb0(%0 : $Int, %1 : @owned $String):
  %2 = struct $IntAndString (%0 : $Int, %1 : $String)
  %3 = begin_borrow %2 : $IntAndString
  %4 = struct_extract %3 : $IntAndString, #IntAndString.s
  %5 = copy_value %4 : $String
  end_borrow %3 : $IntAndString
  destroy_value %2 : $IntAndString
  return %5 : $String
}
