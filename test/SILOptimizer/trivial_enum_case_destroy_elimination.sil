  return %r
}

// CHECK-LABEL: sil [ossa] @destroy_value_of_load_take :
// CHECK:       bb1({{%[0-9]+}} : $Int):
// CHECK-NEXT:    end_borrow
// CHECK-NEXT:    store %1 to [init] %2
// CHECK-NEXT:    br bb3
// CHECK:       } // end sil function 'destroy_value_of_load_take'
sil [ossa] @destroy_value_of_load_take : $@convention(thin) (@guaranteed Holder, @owned E) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E):
  %2 = ref_element_addr %0, #Holder.e
  %3 = load_borrow %2
  switch_enum %3, case #E.b!enumelt: bb1, default bb2

bb1(%5 : $Int):
  end_borrow %3
  %7 = load [take] %2
  store %1 to [init] %2
  destroy_value %7
  br bb3

bb2(%8 : @guaranteed $E):
  end_borrow %3
  destroy_value %1
  br bb3

bb3:
  %r = tuple ()
  return %r
}

// A store to unrelated memory doesn't prevent the optimization.
//
// CHECK-LABEL: sil [ossa] @unrelated_write :
// CHECK:         store %2 to [trivial]
// CHECK-NEXT:    store %1 to [init]
// CHECK:       } // end sil function 'unrelated_write'
sil [ossa] @unrelated_write : $@convention(thin) (@guaranteed Holder, @owned E, Int) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E, %i : $Int):
  %2 = ref_element_addr %0, #Holder.e
  %3 = load_borrow %2
  switch_enum %3, case #E.b!enumelt: bb1, default bb2

bb1(%5 : $Int):
  end_borrow %3
  %x = ref_element_addr %0, #Holder.x
  store %i to [trivial] %x
  store %1 to [assign] %2
  br bb3

bb2(%8 : @guaranteed $E):
  end_borrow %3
  destroy_value %1
  br bb3

bb3:
  %r = tuple ()
  return %r
}

sil @unknown : $@convention(thin) () -> ()

// CHECK-LABEL: sil [ossa] @unknown_call_in_between :
// CHECK:         store %1 to [assign]
// CHECK:       } // end sil function 'unknown_call_in_between'
sil [ossa] @unknown_call_in_between : $@convention(thin) (@guaranteed Holder, @owned E) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E):
  %2 = ref_element_addr %0, #Holder.e
  %3 = load_borrow %2
  switch_enum %3, case #E.b!enumelt: bb1, default bb2

bb1(%5 : $Int):
  end_borrow %3
  %f = function_ref @unknown : $@convention(thin) () -> ()
  %a = apply %f() : $@convention(thin) () -> ()
  store %1 to [assign] %2
  br bb3

bb2(%8 : @guaranteed $E):
  end_borrow %3
  destroy_value %1
  br bb3

bb3:
  %r = tuple ()
  return %r
}

// The MemoryLifetimeVerifier must accept the `store [init]` to memory which contains a trivial
// enum case.
//
// CHECK-LABEL: sil [ossa] @alloc_stack :
// CHECK:         [[S:%.*]] = alloc_stack $E
// CHECK-NEXT:    store {{%[0-9]+}} to [init] [[S]]
// CHECK-NEXT:    store %1 to [init] [[S]]
// CHECK-NEXT:    destroy_addr [[S]]
// CHECK:       } // end sil function 'alloc_stack'
sil [ossa] @alloc_stack : $@convention(thin) (@guaranteed Holder, @owned E, Int) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E, %i : $Int):
  %2 = enum $E, #E.b!enumelt, %i
  %3 = alloc_stack $E
  store %2 to [init] %3
  store %1 to [assign] %3
  destroy_addr %3
  dealloc_stack %3
  %r = tuple ()
  return %r
}

// All predecessors of the merge block are trivial cases.
//
// CHECK-LABEL: sil [ossa] @merge_block_of_trivial_cases :
// CHECK:         store %1 to [init] %2
// CHECK:       } // end sil function 'merge_block_of_trivial_cases'
sil [ossa] @merge_block_of_trivial_cases : $@convention(thin) (@guaranteed Holder, @owned E) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E):
  %2 = ref_element_addr %0, #Holder.e
  %3 = load_borrow %2
  switch_enum %3, case #E.a!enumelt: bb1, case #E.b!enumelt: bb2, case #E.c!enumelt: bb3

bb1(%5 : @guaranteed $C):
  end_borrow %3
  destroy_value %1
  br bb5

bb2(%8 : $Int):
  end_borrow %3
  br bb4

bb3:
  end_borrow %3
  br bb4

bb4:
  store %1 to [assign] %2
  br bb5

bb5:
  %r = tuple ()
  return %r
}

// A loop which doesn't write to the memory.
//
// CHECK-LABEL: sil [ossa] @loop :
// CHECK:         store %1 to [init] %2
// CHECK:       } // end sil function 'loop'
sil [ossa] @loop : $@convention(thin) (@guaranteed Holder, @owned E) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E):
  %2 = ref_element_addr %0, #Holder.e
  %3 = load_borrow %2
  switch_enum %3, case #E.b!enumelt: bb1, default bb4

bb1(%5 : $Int):
  end_borrow %3
  br bb2

bb2:
  cond_br undef, bb2a, bb3

bb2a:
  br bb2

bb3:
  store %1 to [assign] %2
  br bb5

bb4(%8 : @guaranteed $E):
  end_borrow %3
  destroy_value %1
  br bb5

bb5:
  %r = tuple ()
  return %r
}

sil @write_holder : $@convention(thin) (@guaranteed Holder) -> ()

// A loop which may write to the memory.
//
// CHECK-LABEL: sil [ossa] @loop_with_write :
// CHECK:         store %1 to [assign] %2
// CHECK:       } // end sil function 'loop_with_write'
sil [ossa] @loop_with_write : $@convention(thin) (@guaranteed Holder, @owned E) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E):
  %2 = ref_element_addr %0, #Holder.e
  %3 = load_borrow %2
  switch_enum %3, case #E.b!enumelt: bb1, default bb4

bb1(%5 : $Int):
  end_borrow %3
  br bb2

bb2:
  cond_br undef, bb2a, bb3

bb2a:
  %f = function_ref @write_holder : $@convention(thin) (@guaranteed Holder) -> ()
  %a = apply %f(%0) : $@convention(thin) (@guaranteed Holder) -> ()
  br bb2

bb3:
  store %1 to [assign] %2
  br bb5

bb4(%8 : @guaranteed $E):
  end_borrow %3
  destroy_value %1
  br bb5

bb5:
  %r = tuple ()
  return %r
}
