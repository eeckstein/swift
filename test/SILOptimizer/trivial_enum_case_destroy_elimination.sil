// CHECK:         store %1 to [assign] %2
// CHECK:       } // end sil function 'default_case'
sil [ossa] @default_case : $@convention(thin) (@guaranteed Holder, @owned E) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E):
  %2 = ref_element_addr %0, #Holder.e
  %3 = load_borrow %2
  switch_enum %3, case #E.a!enumelt: bb1, default bb2

bb1(%5 : @guaranteed $C):
  end_borrow %3
  destroy_value %1
  br bb3

bb2(%8 : @guaranteed $E):
