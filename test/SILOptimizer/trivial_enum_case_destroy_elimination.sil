// RUN: %target-sil-opt -enable-sil-verify-all %s -trivial-enum-case-destroy-elimination | %FileCheck %s

sil_stage canonical

import Builtin
import Swift

class C {}

enum E {
  case a(C)
  case b(Int)
  case c
}

class Holder {
  @_hasStorage var e: E
  @_hasStorage var x: Int
}

// CHECK-LABEL: sil [ossa] @known_trivial_case_from_switch :
// CHECK:       bb1({{%[0-9]+}} : $Int):
// CHECK-NEXT:    end_borrow
// CHECK-NEXT:    store %1 to [init] %2
// CHECK:       } // end sil function 'known_trivial_case_from_switch'
sil [ossa] @known_trivial_case_from_switch : $@convention(thin) (@guaranteed Holder, @owned E) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E):
  %2 = ref_element_addr %0, #Holder.e
  %3 = load_borrow %2
  switch_enum %3, case #E.b!enumelt: bb1, default bb2

bb1(%5 : $Int):
  end_borrow %3
  store %1 to [assign] %2
  br bb3

bb2(%8 : @guaranteed $E):
  end_borrow %3
  destroy_value %1
  br bb3

bb3:
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @known_no_payload_case_from_switch_with_access_scopes :
// CHECK:       bb2:
// CHECK:         [[A:%.*]] = begin_access [modify] [dynamic] %2
// CHECK-NEXT:    store %1 to [init] [[A]]
// CHECK:       } // end sil function 'known_no_payload_case_from_switch_with_access_scopes'
sil [ossa] @known_no_payload_case_from_switch_with_access_scopes : $@convention(thin) (@guaranteed Holder, @owned E) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E):
  %2 = ref_element_addr %0, #Holder.e
  %3 = begin_access [read] [dynamic] %2
  %4 = load_borrow %3
  switch_enum %4, case #E.c!enumelt: bb2, default bb1

bb1(%6 : @guaranteed $E):
  end_borrow %4
  end_access %3
  destroy_value %1
  br bb3

bb2:
  end_borrow %4
  end_access %3
  %11 = begin_access [modify] [dynamic] %2
  store %1 to [assign] %11
  end_access %11
  br bb3

bb3:
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @known_from_stored_trivial_case :
// CHECK:         [[A:%.*]] = ref_element_addr
// CHECK-NEXT:    store {{%[0-9]+}} to [assign] [[A]]
// CHECK-NEXT:    cond_br
// CHECK:       bb1:
// CHECK-NEXT:    store %1 to [init] [[A]]
// CHECK:       } // end sil function 'known_from_stored_trivial_case'
sil [ossa] @known_from_stored_trivial_case : $@convention(thin) (@guaranteed Holder, @owned E, Int) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E, %i : $Int):
  %2 = enum $E, #E.b!enumelt, %i
  %3 = ref_element_addr %0, #Holder.e
  store %2 to [assign] %3
  cond_br undef, bb1, bb2

bb1:
  store %1 to [assign] %3
  br bb3

bb2:
  destroy_value %1
  br bb3

bb3:
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @non_trivial_case :
// CHECK:         store %1 to [assign] %2
// CHECK:       } // end sil function 'non_trivial_case'
sil [ossa] @non_trivial_case : $@convention(thin) (@guaranteed Holder, @owned E) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E):
  %2 = ref_element_addr %0, #Holder.e
  %3 = load_borrow %2
  switch_enum %3, case #E.a!enumelt: bb1, default bb2

bb1(%5 : @guaranteed $C):
  end_borrow %3
  store %1 to [assign] %2
  br bb3

bb2(%8 : @guaranteed $E):
  end_borrow %3
  destroy_value %1
  br bb3

bb3:
  %r = tuple ()
  return %r
}

