}

// CHECK-LABEL: sil [ossa] @merge_block :
// CHECK:         store %1 to [assign] %2
// CHECK:       } // end sil function 'merge_block'
sil [ossa] @merge_block : $@convention(thin) (@guaranteed Holder, @owned E) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E):
  %2 = ref_element_addr %0, #Holder.e
  %3 = load_borrow %2
  switch_enum %3, case #E.b!enumelt: bb1, default bb2

bb1(%5 : $Int):
  end_borrow %3
  br bb3

bb2(%8 : @guaranteed $E):
  end_borrow %3
  br bb3

bb3:
  store %1 to [assign] %2
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @destroy_addr_known_trivial_case :
// CHECK:       bb1({{%[0-9]+}} : $Int):
// CHECK-NEXT:    end_borrow
// CHECK-NEXT:    store %1 to [init] %2
// CHECK-NOT:     destroy_addr
// CHECK:       } // end sil function 'destroy_addr_known_trivial_case'
sil [ossa] @destroy_addr_known_trivial_case : $@convention(thin) (@guaranteed Holder, @owned E) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E):
  %2 = ref_element_addr %0, #Holder.e
  %3 = load_borrow %2
  switch_enum %3, case #E.b!enumelt: bb1, default bb2

bb1(%5 : $Int):
  end_borrow %3
  destroy_addr %2
  store %1 to [init] %2
  br bb3

bb2(%8 : @guaranteed $E):
  end_borrow %3
  destroy_value %1
  br bb3

bb3:
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @destroy_addr_non_trivial_case :
// CHECK:         destroy_addr %2
// CHECK:       } // end sil function 'destroy_addr_non_trivial_case'
sil [ossa] @destroy_addr_non_trivial_case : $@convention(thin) (@guaranteed Holder, @owned E) -> () {
bb0(%0 : @guaranteed $Holder, %1 : @owned $E):
  %2 = ref_element_addr %0, #Holder.e
