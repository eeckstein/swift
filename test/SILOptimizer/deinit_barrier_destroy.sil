// RUN: %target-sil-opt -module-name test -test-runner %s 2>&1 | %FileCheck %s

// Destroys are deinit barriers if a de-initializer, which may be called by the destroy, is a deinit barrier.
// https://github.com/swiftlang/swift/issues/93240

sil_stage canonical

import Builtin
import Swift

final class BarrierClass {
  deinit
}

final class NoBarrierClass {
  deinit
}

struct BarrierNC: ~Copyable {
  deinit
}

struct NoBarrierNC: ~Copyable {
  deinit
}

struct UnknownDeinitNC: ~Copyable {
  deinit
}

struct NoBarrierStruct {
  @_hasStorage var a: NoBarrierClass
  @_hasStorage var b: Int
}

struct BarrierStruct {
  @_hasStorage var a: NoBarrierClass
  @_hasStorage var b: Optional<BarrierClass>
}

sil @$s4test12BarrierClassCfD : $@convention(method) (@owned BarrierClass) -> () {
[global: read,write,deinit_barrier]
}

sil @$s4test14NoBarrierClassCfD : $@convention(method) (@owned NoBarrierClass) -> () {
[global: read,write]
}

sil @barrier_nc_deinit : $@convention(method) (@owned BarrierNC) -> () {
[global: read,deinit_barrier]
}

sil @no_barrier_nc_deinit : $@convention(method) (@owned NoBarrierNC) -> () {
[global: read]
}

sil_vtable BarrierClass {
  #BarrierClass.deinit!deallocator: @$s4test12BarrierClassCfD
}

sil_vtable NoBarrierClass {
  #NoBarrierClass.deinit!deallocator: @$s4test14NoBarrierClassCfD
}

sil_moveonlydeinit BarrierNC {
  @barrier_nc_deinit
}

sil_moveonlydeinit NoBarrierNC {
  @no_barrier_nc_deinit
}

// CHECK-LABEL: begin running test {{.*}} on destroy_classes: is_deinit_barrier
// CHECK:       destroy_value %0 : $BarrierClass
// CHECK-NEXT:  true
// CHECK-LABEL: begin running test {{.*}} on destroy_classes: is_deinit_barrier
// CHECK:       destroy_value %1 : $NoBarrierClass
// CHECK-NEXT:  false
// CHECK-LABEL: begin running test {{.*}} on destroy_classes: is_deinit_barrier
// CHECK:       destroy_value %2 : $Optional<BarrierClass>
// CHECK-NEXT:  true
// CHECK-LABEL: begin running test {{.*}} on destroy_classes: is_deinit_barrier
// CHECK:       destroy_value %3 : $Optional<NoBarrierClass>
// CHECK-NEXT:  false
sil [ossa] @destroy_classes : $@convention(thin) (@owned BarrierClass, @owned NoBarrierClass, @owned Optional<BarrierClass>, @owned Optional<NoBarrierClass>) -> () {
bb0(%0 : @owned $BarrierClass, %1 : @owned $NoBarrierClass, %2 : @owned $Optional<BarrierClass>, %3 : @owned $Optional<NoBarrierClass>):
  specify_test "is_deinit_barrier @instruction"
  destroy_value %0
  specify_test "is_deinit_barrier @instruction"
  destroy_value %1
  specify_test "is_deinit_barrier @instruction"
  destroy_value %2
  specify_test "is_deinit_barrier @instruction"
  destroy_value %3
  %r = tuple ()
  return %r
}

// CHECK-LABEL: begin running test {{.*}} on destroy_noncopyables: is_deinit_barrier
// CHECK:       destroy_addr %0 : $*BarrierNC
// CHECK-NEXT:  true
// CHECK-LABEL: begin running test {{.*}} on destroy_noncopyables: is_deinit_barrier
// CHECK:       destroy_addr %1 : $*NoBarrierNC
// CHECK-NEXT:  false
// CHECK-LABEL: begin running test {{.*}} on destroy_noncopyables: is_deinit_barrier
// CHECK:       destroy_addr %2 : $*UnknownDeinitNC
// CHECK-NEXT:  true
sil [ossa] @destroy_noncopyables : $@convention(thin) (@in BarrierNC, @in NoBarrierNC, @in UnknownDeinitNC) -> () {
bb0(%0 : $*BarrierNC, %1 : $*NoBarrierNC, %2 : $*UnknownDeinitNC):
  specify_test "is_deinit_barrier @instruction"
  destroy_addr %0
  specify_test "is_deinit_barrier @instruction"
  destroy_addr %1
  specify_test "is_deinit_barrier @instruction"
  destroy_addr %2
  %r = tuple ()
  return %r
}

// CHECK-LABEL: begin running test {{.*}} on destroy_aggregates: is_deinit_barrier
// CHECK:       destroy_value %0 : $NoBarrierStruct
// CHECK-NEXT:  false
// CHECK-LABEL: begin running test {{.*}} on destroy_aggregates: is_deinit_barrier
// CHECK:       destroy_value %1 : $BarrierStruct
// CHECK-NEXT:  true
// CHECK-LABEL: begin running test {{.*}} on destroy_aggregates: is_deinit_barrier
// CHECK:       destroy_value %2 : $(NoBarrierClass, Int)
// CHECK-NEXT:  false
// CHECK-LABEL: begin running test {{.*}} on destroy_aggregates: is_deinit_barrier
// CHECK:       destroy_value %3 : $(NoBarrierClass, BarrierClass)
// CHECK-NEXT:  true
sil [ossa] @destroy_aggregates : $@convention(thin) (@owned NoBarrierStruct, @owned BarrierStruct, @owned (NoBarrierClass, Int), @owned (NoBarrierClass, BarrierClass)) -> () {
bb0(%0 : @owned $NoBarrierStruct, %1 : @owned $BarrierStruct, %2 : @owned $(NoBarrierClass, Int), %3 : @owned $(NoBarrierClass, BarrierClass)):
  specify_test "is_deinit_barrier @instruction"
  destroy_value %0
  specify_test "is_deinit_barrier @instruction"
  destroy_value %1
  specify_test "is_deinit_barrier @instruction"
  destroy_value %2
  specify_test "is_deinit_barrier @instruction"
  destroy_value %3
  %r = tuple ()
  return %r
}

// Unknown de-initializers are conservatively treated as deinit barriers.
// CHECK-LABEL: begin running test {{.*}} on destroy_unknown: is_deinit_barrier
// CHECK:       destroy_value %0 : $AnyObject
// CHECK-NEXT:  true
// CHECK-LABEL: begin running test {{.*}} on destroy_unknown: is_deinit_barrier
// CHECK:       destroy_value %1 : $Builtin.NativeObject
// CHECK-NEXT:  true
// CHECK-LABEL: begin running test {{.*}} on destroy_unknown: is_deinit_barrier
// CHECK:       destroy_value %2 : $@callee_guaranteed () -> ()
// CHECK-NEXT:  true
// CHECK-LABEL: begin running test {{.*}} on destroy_unknown: is_deinit_barrier
// CHECK:       destroy_addr %3 : $*T
// CHECK-NEXT:  true
sil [ossa] @destroy_unknown : $@convention(thin) <T> (@owned AnyObject, @owned Builtin.NativeObject, @owned @callee_guaranteed () -> (), @in T) -> () {
bb0(%0 : @owned $AnyObject, %1 : @owned $Builtin.NativeObject, %2 : @owned $@callee_guaranteed () -> (), %3 : $*T):
  specify_test "is_deinit_barrier @instruction"
  destroy_value %0
  specify_test "is_deinit_barrier @instruction"
  destroy_value %1
  specify_test "is_deinit_barrier @instruction"
  destroy_value %2
  specify_test "is_deinit_barrier @instruction"
  destroy_addr %3
  %r = tuple ()
  return %r
}

// CHECK-LABEL: begin running test {{.*}} on other_destroying_instructions: is_deinit_barrier
// CHECK:       store %0 to [assign] %3 : $*BarrierClass
// CHECK-NEXT:  true
// CHECK-LABEL: begin running test {{.*}} on other_destroying_instructions: is_deinit_barrier
// CHECK:       store %1 to [init] %3 : $*BarrierClass
// CHECK-NEXT:  false
// CHECK-LABEL: begin running test {{.*}} on other_destroying_instructions: is_deinit_barrier
// CHECK:       copy_addr %3 to %4 : $*BarrierClass
// CHECK-NEXT:  true
// CHECK-LABEL: begin running test {{.*}} on other_destroying_instructions: is_deinit_barrier
// CHECK:       copy_addr [take] %4 to [init] %3 : $*BarrierClass
// CHECK-NEXT:  false
// CHECK-LABEL: begin running test {{.*}} on other_destroying_instructions: is_deinit_barrier
// CHECK:       destroy_value [dead_end] %2 : $BarrierClass
// CHECK-NEXT:  false
sil [ossa] @other_destroying_instructions : $@convention(thin) (@owned BarrierClass, @owned BarrierClass, @owned BarrierClass, @inout BarrierClass, @inout BarrierClass) -> () {
bb0(%0 : @owned $BarrierClass, %1 : @owned $BarrierClass, %2 : @owned $BarrierClass, %3 : $*BarrierClass, %4 : $*BarrierClass):
  specify_test "is_deinit_barrier @instruction"
  store %0 to [assign] %3
  %5 = load [take] %3
  destroy_value %5
  specify_test "is_deinit_barrier @instruction"
  store %1 to [init] %3
  specify_test "is_deinit_barrier @instruction"
  copy_addr %3 to %4
  destroy_addr %3
  specify_test "is_deinit_barrier @instruction"
  copy_addr [take] %4 to [init] %3
  copy_addr %3 to [init] %4
  cond_br undef, bb1, bb2

bb1:
  specify_test "is_deinit_barrier @instruction"
  destroy_value [dead_end] %2
  unreachable

bb2:
  destroy_value %2
  %r = tuple ()
  return %r
}

// Destroying the result of a `drop_deinit` doesn't call the deinit.
// CHECK-LABEL: begin running test {{.*}} on destroy_dropped_deinit: is_deinit_barrier
// CHECK:       destroy_value %1 : $BarrierNC
// CHECK-NEXT:  false
sil [ossa] @destroy_dropped_deinit : $@convention(thin) (@owned BarrierNC) -> () {
bb0(%0 : @owned $BarrierNC):
  %1 = drop_deinit %0
  specify_test "is_deinit_barrier @instruction"
  destroy_value %1
  %r = tuple ()
  return %r
}
