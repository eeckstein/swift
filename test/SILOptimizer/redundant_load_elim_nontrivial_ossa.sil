  return %8 : $Klass
}


// A `load_borrow` of a sub-field, contained in the liverange of the `load [take]`.
// The `load_borrow` is replaced by a `begin_borrow` of the available value plus a projection.
// The scope ending `end_borrow` must end the `begin_borrow` and not the projected value,
// because a projection is not a borrow introducer.
// CHECK-LABEL: @load_take_with_contained_load_borrow :
// CHECK:         [[B:%.*]] = begin_borrow %0
// CHECK-NEXT:    [[F:%.*]] = struct_extract [[B]] : $NonTrivialStruct, #NonTrivialStruct.val
// CHECK-NEXT:    unchecked_ref_cast [[F]]
// CHECK-NEXT:    end_borrow [[B]]
// CHECK-NOT:     load
// CHECK:       } // end sil function 'load_take_with_contained_load_borrow'
sil [ossa] @load_take_with_contained_load_borrow : $@convention(thin) (@owned NonTrivialStruct) -> @owned NonTrivialStruct {
bb0(%0 : @owned $NonTrivialStruct):
  %1 = alloc_stack $NonTrivialStruct
  store %0 to [init] %1 : $*NonTrivialStruct
  %2 = struct_element_addr %1 : $*NonTrivialStruct, #NonTrivialStruct.val
  %3 = load_borrow %2 : $*Klass
  %4 = unchecked_ref_cast %3 : $Klass to $Builtin.NativeObject
  end_borrow %3 : $Klass
  %5 = load [take] %1 : $*NonTrivialStruct
  dealloc_stack %1 : $*NonTrivialStruct
  return %5 : $NonTrivialStruct
}

// A `load [take]` with a liverange exit (bb2) which is not a dead-end block: the value must be
// stored back to memory in the exit block. The address of the load does not dominate the exit
// block, therefore it must be re-created from the base of the access.
// CHECK-LABEL: @load_take_exit_block_projected_address :
// CHECK:         [[F:%.*]] = destructure_struct %0
// CHECK:       bb2:
// CHECK-NEXT:    [[SEA:%.*]] = struct_element_addr %{{[0-9]+}} : $*NonTrivialStruct, #NonTrivialStruct.val
// CHECK-NEXT:    store [[F]] to [init] [[SEA]]
// CHECK:       } // end sil function 'load_take_exit_block_projected_address'
sil [ossa] @load_take_exit_block_projected_address : $@convention(thin) (@owned NonTrivialStruct, Builtin.Int1) -> () {
bb0(%0 : @owned $NonTrivialStruct, %1 : $Builtin.Int1):
  %2 = alloc_stack $NonTrivialStruct
  store %0 to [init] %2 : $*NonTrivialStruct
  cond_br %1, bb1, bb2

bb1:
  %3 = struct_element_addr %2 : $*NonTrivialStruct, #NonTrivialStruct.val
  %4 = load [take] %3 : $*Klass
  destroy_value %4 : $Klass
  dealloc_stack %2 : $*NonTrivialStruct
  br bb3

bb2:
  %5 = function_ref @modify_nontrivialstruct : $@convention(thin) (@inout NonTrivialStruct) -> ()
  %6 = apply %5(%2) : $@convention(thin) (@inout NonTrivialStruct) -> ()
  destroy_addr %2 : $*NonTrivialStruct
  dealloc_stack %2 : $*NonTrivialStruct
  br bb3

bb3:
  %7 = tuple ()
  return %7 : $()
}

// Like `load_take_exit_block_projected_address`, but the load is within an access scope.
// The address must be re-created from the `begin_access` and not from the access base.
// Otherwise the inserted store would bypass the access scope, which breaks optimizations which
// rely on the fact that all accesses within an access scope go through the `begin_access`.
// CHECK-LABEL: @load_take_exit_block_address_in_access_scope :
// CHECK:         [[BA:%.*]] = begin_access [modify] [dynamic] %{{[0-9]+}} : $*NonTrivialStruct
// CHECK:         [[F:%.*]] = destructure_struct %1
// CHECK:       bb2:
// CHECK-NEXT:    [[SEA:%.*]] = struct_element_addr [[BA]] : $*NonTrivialStruct, #NonTrivialStruct.val
// CHECK-NEXT:    store [[F]] to [init] [[SEA]]
// CHECK:       } // end sil function 'load_take_exit_block_address_in_access_scope'
sil [ossa] @load_take_exit_block_address_in_access_scope : $@convention(thin) (@owned NonTrivialStruct, @owned NonTrivialStruct, Builtin.Int1) -> () {
bb0(%0 : @owned $NonTrivialStruct, %1 : @owned $NonTrivialStruct, %2 : $Builtin.Int1):
  %3 = alloc_stack $NonTrivialStruct
  store %0 to [init] %3 : $*NonTrivialStruct
  %4 = begin_access [modify] [dynamic] %3 : $*NonTrivialStruct
  store %1 to [assign] %4 : $*NonTrivialStruct
  cond_br %2, bb1, bb2

bb1:
  %5 = struct_element_addr %4 : $*NonTrivialStruct, #NonTrivialStruct.val
  %6 = load [take] %5 : $*Klass
  destroy_value %6 : $Klass
  br bb3

bb2:
  %7 = function_ref @modify_nontrivialstruct : $@convention(thin) (@inout NonTrivialStruct) -> ()
  %8 = apply %7(%4) : $@convention(thin) (@inout NonTrivialStruct) -> ()
  destroy_addr %4 : $*NonTrivialStruct
  br bb3

bb3:
  end_access %4 : $*NonTrivialStruct
  dealloc_stack %3 : $*NonTrivialStruct
  %9 = tuple ()
  return %9 : $()
}

// A contained `load_borrow` in a loop header. The available value of the `load_borrow`'s block is
// located _after_ the `load_borrow`. Therefore the `load_borrow` must borrow the value which comes
// into the block - and not the available value of its own block, which would create a cycle.
// CHECK-LABEL: @load_borrow_with_available_value_after_it :
// CHECK:       bb1([[PHI:%.*]] : @owned $Klass):
// CHECK-NEXT:    [[B:%.*]] = begin_borrow [[PHI]]
// CHECK:         [[NEW:%.*]] = apply %{{[0-9]+}}([[B]])
// CHECK-NEXT:    end_borrow [[B]]
// CHECK-NEXT:    destroy_value [[PHI]]
// CHECK-NOT:     load_borrow
// CHECK:       } // end sil function 'load_borrow_with_available_value_after_it'
sil [ossa] @load_borrow_with_available_value_after_it : $@convention(thin) (@owned Klass) -> () {
bb0(%0 : @owned $Klass):
  %1 = alloc_stack $Klass
  store %0 to [init] %1 : $*Klass
  br bb1

bb1:
  %2 = load_borrow %1 : $*Klass
  %3 = function_ref @borrow_and_produce_klass : $@convention(thin) (@guaranteed Klass) -> @owned Klass
  %4 = apply %3(%2) : $@convention(thin) (@guaranteed Klass) -> @owned Klass
  end_borrow %2 : $Klass
  destroy_addr %1 : $*Klass
  fix_lifetime %4 : $Klass
  store %4 to [init] %1 : $*Klass
  cond_br undef, bb2, bb3

bb2:
  br bb1

bb3:
  %5 = function_ref @test_rle_in_guaranteed_callee : $@convention(thin) (@in_guaranteed Klass) -> ()
  %6 = apply %5(%1) : $@convention(thin) (@in_guaranteed Klass) -> ()
  destroy_addr %1 : $*Klass
  dealloc_stack %1 : $*Klass
  %7 = tuple ()
  return %7 : $()
}

