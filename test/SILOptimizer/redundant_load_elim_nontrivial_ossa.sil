  store %1 to [assign] %2
  %4 = struct_element_addr %2, #Agg2.t
  %5 = tuple_element_addr %4, 0
  copy_addr [take] %5 to [init] %0
  store %3 to [init] %5
  %r = tuple ()
  return %r
}

