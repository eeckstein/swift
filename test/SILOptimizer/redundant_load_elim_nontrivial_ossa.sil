  %4 = tuple_element_addr %3 : $*(Klass, Klass), 0
  %6 = load [take] %4 : $*Klass
  store %2 to [init] %4 : $*Klass
  return %6 : $Klass
}

// CHECK-LABEL: @copyaddr_take_from_store_assign :
// CHECK:         destroy_addr %2
