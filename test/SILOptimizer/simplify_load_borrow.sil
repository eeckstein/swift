// RUN: %target-sil-opt %s -onone-simplification -simplify-instruction=load_borrow | %FileCheck %s
// RUN: %target-sil-opt %s -simplification -simplify-instruction=load_borrow | %FileCheck %s

import Swift
import Builtin

class B { }

class E : B {
  @_hasStorage var i: Int
}

struct S {
  let b: B
  let i: Int
}

sil_global private @gstatic_b : $B = {
  %initval = object $B ()
}

sil_global private @gstatic_b2 : $B = {
  %initval = object $B ()
}

enum EnumWithB {
  case a(B)
  case b
}

sil @use_b : $@convention(thin) (@guaranteed B) -> ()

// CHECK-LABEL: sil [ossa] @load_borrow_and_copy :
// CHECK:         %1 = load [copy] %0
// CHECK:         %2 = begin_borrow %1
// CHECK:         %3 = ref_element_addr %2, #E.i
// CHECK:         %4 = load [trivial] %3
// CHECK:         end_borrow %2
// CHECK:         destroy_value %1 
// CHECK:         return %4
// CHECK:       } // end sil function 'load_borrow_and_copy'
sil [ossa] @load_borrow_and_copy : $@convention(thin) (@inout E) -> Int {
bb0(%0 : $*E):
  %1 = load_borrow %0
  %2 = copy_value %1
  end_borrow %1
  %4 = begin_borrow %2
  %5 = ref_element_addr %4, #E.i
  %6 = load [trivial] %5
  end_borrow %4
  destroy_value %2
  return %6
}

// CHECK-LABEL: sil [ossa] @load_borrow_and_copy_forwarding :
// CHECK:         %1 = load [copy] %0
// CHECK:         %2 = unchecked_ref_cast %1 to $E
// CHECK:         %3 = begin_borrow %2
// CHECK:         %4 = ref_element_addr %3, #E.i
// CHECK:         %5 = load [trivial] %4
// CHECK:         end_borrow %3
// CHECK:         destroy_value %2 
// CHECK:         return %5
// CHECK:       } // end sil function 'load_borrow_and_copy_forwarding'
sil [ossa] @load_borrow_and_copy_forwarding : $@convention(thin) (@inout B) -> Int {
bb0(%0 : $*B):
  %1 = load_borrow %0
  %2 = unchecked_ref_cast %1 to $E
  %3 = copy_value %2
  end_borrow %1
  %5 = begin_borrow %3
  %6 = ref_element_addr %5, #E.i
  %7 = load [trivial] %6
  end_borrow %5
  destroy_value %3
  return %7
}

// CHECK-LABEL: sil [ossa] @load_borrow_and_copy_different_block :
// CHECK:         %1 = load_borrow %0
// CHECK:         %3 = copy_value %1
// CHECK:       } // end sil function 'load_borrow_and_copy_different_block'
sil [ossa] @load_borrow_and_copy_different_block : $@convention(thin) (@inout E) -> () {
bb0(%0 : $*E):
  %1 = load_borrow %0
  cond_br undef, bb1, bb2
bb1:
  %3 = copy_value %1
  %4 = begin_borrow %3
  %5 = ref_element_addr %4, #E.i
  %6 = load [trivial] %5
  fix_lifetime %6
  end_borrow %4
  destroy_value %3
  br bb3
bb2:
  br bb3
bb3:
  end_borrow %1
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @dead_load_borrow :
// CHECK-NOT:     load_borrow
// CHECK:         %1 = tuple ()
// CHECK:         return %1
// CHECK:       } // end sil function 'dead_load_borrow'
sil [ossa] @dead_load_borrow : $@convention(thin) (@inout B) -> () {
bb0(%0 : $*B):
  %1 = load_borrow %0
  debug_value %1, var, name "x"
  end_borrow %1
  %4 = tuple ()
  return %4
}

// CHECK-LABEL: sil [ossa] @load_of_addr_cast :
// CHECK:         %1 = load_borrow %0
// CHECK:         %2 = unchecked_ref_cast %1 to $AnyObject
// CHECK:         fix_lifetime %2
// CHECK:         end_borrow %1
// CHECK:       } // end sil function 'load_of_addr_cast'
sil [ossa] @load_of_addr_cast : $@convention(thin) (@inout B) -> () {
bb0(%0 : $*B):
  %1 = unchecked_addr_cast %0 to $*AnyObject
  %2 = load_borrow %1
  fix_lifetime %2
  end_borrow %2
  %6 = tuple ()
  return %6
}

// CHECK-LABEL: sil [ossa] @load_of_store_borrow :
// CHECK:       bb1:
// CHECK-NEXT:    %4 = begin_borrow %0
// CHECK-NEXT:    fix_lifetime %4
// CHECK-NEXT:    end_borrow %4
// CHECK:       } // end sil function 'load_of_store_borrow'
sil [ossa] @load_of_store_borrow : $@convention(thin) (@guaranteed B) -> () {
bb0(%0 : @guaranteed $B):
  %1 = alloc_stack $B
  %2 = store_borrow %0 to %1
  cond_br undef, bb1, bb2

bb1:
  %4 = load_borrow %2
  fix_lifetime %4
  end_borrow %4
  br bb3

bb2:
  br bb3

bb3:
  end_borrow %2
  dealloc_stack %1
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @load_of_store_borrow2 :
// CHECK:       bb1:
// CHECK-NEXT:    %4 = begin_borrow %0
// CHECK-NEXT:    %5 = struct_extract %4, #S.b
// CHECK-NEXT:    fix_lifetime %5
// CHECK-NEXT:    end_borrow %4
// CHECK:       } // end sil function 'load_of_store_borrow2'
sil [ossa] @load_of_store_borrow2 : $@convention(thin) (@owned S) -> @owned S {
bb0(%0 : @owned $S):
  %1 = alloc_stack $S
  %2 = store_borrow %0 to %1
  cond_br undef, bb1, bb2

bb1:
  %4 = struct_element_addr %2, #S.b
  %5 = load_borrow %4
  fix_lifetime %5
  end_borrow %5
  br bb3

bb2:
  br bb3

bb3:
  end_borrow %2
  dealloc_stack %1
  return %0
}

// CHECK-LABEL: sil [ossa] @dont_optimize_load_borrow_with_reborrow :
// CHECK:         %4 = load_borrow %3
// CHECK:       } // end sil function 'dont_optimize_load_borrow_with_reborrow'
sil [ossa] @dont_optimize_load_borrow_with_reborrow : $@convention(thin) (@owned S) -> @owned S {
bb0(%0 : @owned $S):
  %1 = alloc_stack $S
  %2 = store_borrow %0 to %1
  %3 = struct_element_addr %2, #S.b
  %4 = load_borrow %3
  br bb1(%4)

bb1(%5 : @reborrow $B):
  %6 = borrowed %5 from ()
  end_borrow %6
  end_borrow %2
  dealloc_stack %1
  return %0
}

struct FnBox {
  let fn: () -> ()
  let i: Int
}

sil @someFn : $@convention(thin) () -> ()
sil @useFnBox : $@convention(thin) (@guaranteed FnBox) -> ()

sil_global [let] @gfnbox : $FnBox = {
  %0 = function_ref @someFn : $@convention(thin) () -> ()
  %1 = thin_to_thick_function %0 : $@convention(thin) () -> () to $@callee_guaranteed () -> ()
  %2 = integer_literal $Builtin.Int64, 27
  %3 = struct $Int (%2 : $Builtin.Int64)
  %initval = struct $FnBox (%1 : $@callee_guaranteed () -> (), %3 : $Int)
}

// The load_borrow of a global let is replaced by its static initializer value. The cloned value
// is not a borrow, so it's borrowed for the guaranteed uses and destroyed where the original
// borrow scope ended. The cloned value has `.none` ownership here, so in a full pipeline
// SimplifyDestroyValue would remove the destroy_value again.
// CHECK-LABEL: sil [ossa] @load_borrow_global_let :
// CHECK-NOT:     global_addr
// CHECK:         [[F:%.*]] = function_ref @someFn
// CHECK:         [[TTF:%.*]] = thin_to_thick_function [[F]]
// CHECK:         [[S:%.*]] = struct $FnBox ([[TTF]], {{%.*}})
// CHECK:         [[B:%.*]] = begin_borrow [[S]]
// CHECK:         apply {{%.*}}([[B]])
// CHECK:         end_borrow [[B]]
// CHECK:         destroy_value [[S]]
// CHECK:       } // end sil function 'load_borrow_global_let'
sil [ossa] @load_borrow_global_let : $@convention(thin) () -> () {
bb0:
  %0 = global_addr @gfnbox : $*FnBox
  %1 = load_borrow %0 : $*FnBox
  %2 = function_ref @useFnBox : $@convention(thin) (@guaranteed FnBox) -> ()
  %3 = apply %2(%1) : $@convention(thin) (@guaranteed FnBox) -> ()
  end_borrow %1 : $FnBox
  %5 = tuple ()
  return %5 : $()
}

sil @useB : $@convention(thin) (@guaranteed B) -> ()

sil_global private @gobj_storage : $B = {
  %initval = object $B ()
}

sil_global hidden [let] @gobj : $B

sil [global_init_once_fn] @init_gobj : $@convention(c) () -> () {
bb0:
  alloc_global @gobj
  %1 = global_addr @gobj : $*B
  %2 = global_value @gobj_storage : $B
  store %2 to %1 : $*B
  %4 = tuple ()
  return %4 : $()
}

// Same, but the initializer value is not a static initializer of the global. It's taken from the
// global's init-once function, which is also erased if it has no side effects.
// CHECK-LABEL: sil [ossa] @load_borrow_global_let_init_fn :
// CHECK-NOT:     global_addr
// CHECK:         [[GV:%.*]] = global_value @gobj_storage
// CHECK:         [[B:%.*]] = begin_borrow [[GV]]
// CHECK:         apply {{%.*}}([[B]])
// CHECK:         end_borrow [[B]]
// CHECK:         destroy_value [[GV]]
// CHECK:       } // end sil function 'load_borrow_global_let_init_fn'
sil [ossa] @load_borrow_global_let_init_fn : $@convention(thin) (Builtin.RawPointer) -> () {
bb0(%0 : $Builtin.RawPointer):
  %1 = function_ref @init_gobj : $@convention(c) () -> ()
  %2 = builtin "once"(%0 : $Builtin.RawPointer, %1 : $@convention(c) () -> ()) : $Builtin.SILToken
  %3 = global_addr @gobj : $*B depends_on %2
  %4 = load_borrow %3 : $*B
  %5 = function_ref @useB : $@convention(thin) (@guaranteed B) -> ()
  %6 = apply %5(%4) : $@convention(thin) (@guaranteed B) -> ()
  end_borrow %4 : $B
  %8 = tuple ()
  return %8 : $()
}

// If the value hint of the load_borrow doesn't need to be kept alive by a borrow scope, the
// load_borrow can be replaced by it.
// CHECK-LABEL: sil [ossa] @load_borrow_with_ownership_free_value_hint :
// CHECK:         [[G:%.*]] = global_value @gstatic_b
// CHECK-NOT:     load_borrow
// CHECK:         apply %{{[0-9]+}}([[G]])
// CHECK:       } // end sil function 'load_borrow_with_ownership_free_value_hint'
sil [ossa] @load_borrow_with_ownership_free_value_hint : $@convention(thin) (@inout B) -> () {
bb0(%0 : $*B):
  %1 = global_value @gstatic_b : $B
  store %1 to [assign] %0
  %3 = load_borrow %0, value_hint %1
  %4 = function_ref @use_b : $@convention(thin) (@guaranteed B) -> ()
  apply %4(%3) : $@convention(thin) (@guaranteed B) -> ()
  end_borrow %3
  %r = tuple ()
  return %r
}

// The value hint only fakes "none" ownership for an owned value, which needs a lifetime.
// The load_borrow must not be replaced.
// CHECK-LABEL: sil [ossa] @load_borrow_with_faked_ownership_free_value_hint :
// CHECK:         load_borrow %0, value_hint
// CHECK:       } // end sil function 'load_borrow_with_faked_ownership_free_value_hint'
sil [ossa] @load_borrow_with_faked_ownership_free_value_hint : $@convention(thin) (@inout B, @owned B) -> () {
bb0(%0 : $*B, %1 : @owned $B):
  %2 = unchecked_ownership %1, forwarding: @none
  store %1 to [assign] %0
  %4 = load_borrow %0, value_hint %2
  %5 = function_ref @use_b : $@convention(thin) (@guaranteed B) -> ()
  apply %5(%4) : $@convention(thin) (@guaranteed B) -> ()
  end_borrow %4
  %r = tuple ()
  return %r
}

// The value hint is a phi of values which genuinely don't have ownership.
// CHECK-LABEL: sil [ossa] @load_borrow_with_phi_value_hint :
// CHECK:       bb3([[PHI:%[0-9]+]] : $B):
// CHECK-NOT:     load_borrow
// CHECK:         apply %{{[0-9]+}}([[PHI]])
// CHECK:       } // end sil function 'load_borrow_with_phi_value_hint'
sil [ossa] @load_borrow_with_phi_value_hint : $@convention(thin) (@inout B, Builtin.Int1) -> () {
bb0(%0 : $*B, %1 : $Builtin.Int1):
  cond_br %1, bb1, bb2

bb1:
  %2 = global_value @gstatic_b : $B
  br bb3(%2)

bb2:
  %3 = global_value @gstatic_b2 : $B
  br bb3(%3)

bb3(%4 : $B):
  %5 = load_borrow %0, value_hint %4
  %6 = function_ref @use_b : $@convention(thin) (@guaranteed B) -> ()
  apply %6(%5) : $@convention(thin) (@guaranteed B) -> ()
  end_borrow %5
  %r = tuple ()
  return %r
}

// The value hint is a `switch_enum` payload whose "none" ownership is faked by the
// `unchecked_ownership` of an owned enum. The load_borrow must not be replaced.
// CHECK-LABEL: sil [ossa] @load_borrow_with_terminator_result_value_hint :
// CHECK:         load_borrow %0, value_hint
// CHECK:       } // end sil function 'load_borrow_with_terminator_result_value_hint'
sil [ossa] @load_borrow_with_terminator_result_value_hint : $@convention(thin) (@inout B, @owned EnumWithB) -> () {
bb0(%0 : $*B, %1 : @owned $EnumWithB):
  %2 = unchecked_ownership %1, forwarding: @none
  switch_enum %2, case #EnumWithB.a!enumelt: bb1, case #EnumWithB.b!enumelt: bb2

bb1(%4 : $B):
  %5 = load_borrow %0, value_hint %4
  %6 = function_ref @use_b : $@convention(thin) (@guaranteed B) -> ()
  apply %6(%5) : $@convention(thin) (@guaranteed B) -> ()
  end_borrow %5
  br bb3

bb2:
  br bb3

bb3:
  destroy_value %1
  %r = tuple ()
  return %r
}
