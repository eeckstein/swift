// RUN: %target-sil-opt -enable-sil-verify-all %s -onone-simplification -simplify-instruction=tuple_extract | %FileCheck %s


import Swift
import Builtin

// CHECK-LABEL: sil @tuple_extract_first_field
// CHECK:         return %0
// CHECK:       } // end sil function 'tuple_extract_first_field'
sil @tuple_extract_first_field : $@convention(thin) (@owned String, @guaranteed String) -> @owned String {
bb0(%0 : $String, %1 : $String):
  %2 = tuple (%0 : $String, %1 : $String)
  %3 = tuple_extract %2 : $(String, String), 0
  return %3 : $String
}

// CHECK-LABEL: sil @tuple_extract_second_field
// CHECK:         return %1
// CHECK:       } // end sil function 'tuple_extract_second_field'
sil @tuple_extract_second_field : $@convention(thin) (@guaranteed String, @owned String) -> @owned String {
bb0(%0 : $String, %1 : $String):
  %2 = tuple (%0 : $String, %1 : $String)
  %3 = tuple_extract %2 : $(String, String), 1
  return %3 : $String
}

// CHECK-LABEL: sil [ossa] @tuple_extract_ossa
// CHECK:         %2 = copy_value %0
// CHECK:         return %2
// CHECK:       } // end sil function 'tuple_extract_ossa'
sil [ossa] @tuple_extract_ossa : $@convention(thin) (@guaranteed String, @guaranteed String) -> @owned String {
bb0(%0 : @guaranteed $String, %1 : @guaranteed $String):
  %2 = tuple (%0 : $String, %1 : $String)
  %3 = tuple_extract %2 : $(String, String), 0
  %4 = copy_value %3 : $String
  return %4 : $String
}


// CHECK-LABEL: sil [ossa] @tuple_extract_of_borrowed_tuple_none_element :
// CHECK:         [[B:%.*]] = begin_borrow
// CHECK-NOT:     tuple_extract
// CHECK:         end_borrow [[B]]
// CHECK:         return %0
// CHECK:       } // end sil function 'tuple_extract_of_borrowed_tuple_none_element'
sil [ossa] @tuple_extract_of_borrowed_tuple_none_element : $@convention(thin) (Int, @owned String) -> Int {
bb0(%0 : $Int, %1 : @owned $String):
  %2 = tuple (%0 : $Int, %1 : $String)
  %3 = begin_borrow %2 : $(Int, String)
  %4 = tuple_extract %3 : $(Int, String), 0
  end_borrow %3 : $(Int, String)
  destroy_value %2 : $(Int, String)
  return %4 : $Int
}

// CHECK-LABEL: sil [ossa] @tuple_extract_of_borrowed_tuple_owned_element :
// CHECK:         [[B:%.*]] = begin_borrow
// CHECK:         [[E:%.*]] = tuple_extract [[B]], 1
// CHECK:         copy_value [[E]]
// CHECK:       } // end sil function 'tuple_extract_of_borrowed_tuple_owned_element'
sil [ossa] @tuple_extract_of_borrowed_tuple_owned_element : $@convention(thin) (Int, @owned String) -> @owned String {
bb0(%0 : $Int, %1 : @owned $String):
  %2 = tuple (%0 : $Int, %1 : $String)
  %3 = begin_borrow %2 : $(Int, String)
  %4 = tuple_extract %3 : $(Int, String), 1
  %5 = copy_value %4 : $String
  end_borrow %3 : $(Int, String)
  destroy_value %2 : $(Int, String)
  return %5 : $String
}
