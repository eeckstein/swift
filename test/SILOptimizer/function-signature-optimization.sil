// CHECK:         [[F:%.*]] = function_ref @dont_borrow_recursive_result_across_write :
// CHECK:         apply [[F]](%0, %1)
// CHECK:       } // end sil function 'call_dont_borrow_recursive_result_across_write'
sil [ossa] @call_dont_borrow_recursive_result_across_write : $@convention(thin) (@inout S, Builtin.Int1) -> () {
bb0(%0 : $*S, %1 : $Builtin.Int1):
  %2 = function_ref @dont_borrow_recursive_result_across_write : $@convention(thin) (@inout S, Builtin.Int1) -> @owned S
