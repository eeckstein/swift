bb0(%0 : @guaranteed $AnyObject):
  %1 = copy_value %0
  %2 = apply undef(%1) : $@convention(thin) (@owned AnyObject) -> ()
  %3 = tuple ()
  return %3
}

// CHECK-LABEL: sil [ossa] @call_guaranteed_arg :
// CHECK:         [[B:%.*]] = begin_borrow %0
// CHECK:         [[C:%.*]] = copy_value [[B]]
// CHECK:         [[F:%.*]] = function_ref @$s14guaranteed_argTf4o_n : $@convention(thin) (@owned AnyObject) -> ()
// CHECK:         apply [[F]]([[C]])
// CHECK:         end_borrow [[B]]
// CHECK:         destroy_value %0
// CHECK:       } // end sil function 'call_guaranteed_arg'
sil [ossa] @call_guaranteed_arg : $@convention(thin) (@owned AnyObject) -> () {
bb0(%0 : @owned $AnyObject):
  %2 = function_ref @guaranteed_arg : $@convention(thin) (@guaranteed AnyObject) -> ()
  %3 = apply %2(%0) : $@convention(thin) (@guaranteed AnyObject) -> ()
  destroy_value %0
  return %3
}

