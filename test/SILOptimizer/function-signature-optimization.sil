sil @s_user : $@convention(thin) (@guaranteed S) -> ()

// The result of the *returned* recursive call stays valid, but the result of the first recursive
// call is used across a write to the borrowed argument memory
// CHECK-LABEL: sil shared [ossa] @$s34copy_recursive_result_across_writeTf4nn_g : $@convention(thin) (@inout S, Builtin.Int1) -> @guaranteed S {
// CHECK:       bb2:
// CHECK:         [[A1:%.*]] = apply {{.*}} : $@convention(thin) (@inout S, Builtin.Int1) -> @owned S
// CHECK-NEXT:    [[C:%.*]] = load [copy] %0
// CHECK:         store
// CHECK:         apply {{.*}}([[A1]]) : $@convention(thin) (@guaranteed S) -> ()
// CHECK:         destroy_value [[A1]]
// CHECK:         [[A2:%.*]] = apply {{.*}} : $@convention(thin) (@inout S, Builtin.Int1) -> @guaranteed S
// CHECK-NEXT:    [[BB:%.*]] = begin_borrow [[A2]]
// CHECK-NEXT:    br bb3([[BB]])
// CHECK:       } // end sil function '$s34copy_recursive_result_across_writeTf4nn_g'
sil [ossa] @copy_recursive_result_across_write : $@convention(thin) (@inout S, Builtin.Int1) -> @owned S {
bb0(%0 : $*S, %1 : $Builtin.Int1):
  cond_br %1, bb1, bb2

bb1:
  %2 = load [copy] %0
  br bb3(%2)

bb2:
  %4 = function_ref @copy_recursive_result_across_write : $@convention(thin) (@inout S, Builtin.Int1) -> @owned S
  %5 = apply %4(%0, %1) : $@convention(thin) (@inout S, Builtin.Int1) -> @owned S
  %6 = load [copy] %0
  store %6 to [assign] %0
  %8 = function_ref @s_user : $@convention(thin) (@guaranteed S) -> ()
  %9 = apply %8(%5) : $@convention(thin) (@guaranteed S) -> ()
  destroy_value %5
  %11 = apply %4(%0, %1) : $@convention(thin) (@inout S, Builtin.Int1) -> @owned S
  br bb3(%11)

bb3(%13 : @owned $S):
  return %13
}

