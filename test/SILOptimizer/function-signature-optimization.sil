// CHECK-LABEL: sil [signature_optimized_thunk] [ossa] @partial_dead_arg : $@convention(thin) (@guaranteed S) -> () {
// CHECK:       bb0(%0 : @guaranteed $S):
// CHECK:         %1 = begin_borrow %0
// CHECK:         (%2, %3) = destructure_struct %1
// CHECK:         %4 = function_ref @$s16partial_dead_argTf4x_n : $@convention(thin) (@guaranteed AnyObject, @guaranteed AnyObject) -> ()
// CHECK:         %5 = apply %4(%2, %3) : $@convention(thin) (@guaranteed AnyObject, @guaranteed AnyObject) -> ()
// CHECK:         end_borrow %1                                   // id: %6
// CHECK:       } // end sil function 'partial_dead_arg'
sil [ossa] @partial_dead_arg : $@convention(thin) (@guaranteed S) -> () {
bb0(%0 : @guaranteed $S):
  %1 = struct_extract %0, #S.x
  fix_lifetime %1
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @call_partial_dead_arg :
// CHECK:         ([[X:%.*]], [[Y:%.*]]) = destructure_struct
// CHECK:         [[B:%.*]] = begin_borrow [lexical] [[X]]
