// RUN: %target-sil-opt -module-name=test -function-signature-optimization %s | %FileCheck %s

sil_stage canonical

import Swift
import Builtin
import SwiftShims

struct S {
  var x: AnyObject
  var y: AnyObject
}

struct GenS<T> {
  var x: Array<T>
  var y: Array<T>
}

struct S2 {
  var x: Int
  var y: AnyObject
}

// CHECK-LABEL: sil shared [ossa] @$s8dead_argTf4dn_n : $@convention(thin) (Int) -> Int {
// CHECK:       bb0(%0 : $Int):
// CHECK-NEXT:    return %0
// CHECK:       } // end sil function '$s8dead_argTf4dn_n'

// CHECK-LABEL: sil [signature_optimized_thunk] [ossa] @dead_arg :
// CHECK:         %2 = function_ref @$s8dead_argTf4dn_n : $@convention(thin) (Int) -> Int
// CHECK:         %3 = apply %2(%1)
// CHECK:         return %3
// CHECK:       } // end sil function 'dead_arg'
sil [ossa] @dead_arg : $@convention(thin) (@guaranteed AnyObject, Int) -> Int {
bb0(%0 : @guaranteed $AnyObject, %1 : $Int):
  return %1
}

// CHECK-LABEL: sil [ossa] @call_dead_arg :
// CHECK:         [[F:%.*]] = function_ref @$s8dead_argTf4dn_n :
// CHECK:         [[A:%.*]] = apply [[F]](%1)
// CHECK:         br bb1([[A]])
// CHECK:       bb1([[R:%.*]] : $Int):
// CHECK:         return [[R]]
// CHECK:       } // end sil function 'call_dead_arg'
sil [ossa] @call_dead_arg : $@convention(thin) (@guaranteed AnyObject, Int) -> Int {
bb0(%0 : @guaranteed $AnyObject, %1 : $Int):
  %2 = function_ref @dead_arg : $@convention(thin) (@guaranteed AnyObject, Int) -> Int
  %3 = apply %2(%0, %1) : $@convention(thin) (@guaranteed AnyObject, Int) -> Int
  return %3
}

// CHECK-LABEL: sil shared [ossa] @$s14guaranteed_argTf4o_n : $@convention(thin) (@owned AnyObject) -> () {
