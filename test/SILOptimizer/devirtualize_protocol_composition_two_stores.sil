// RUN: %target-sil-opt -O -wmo -enable-sil-verify-all %s | %FileCheck %s


sil_stage canonical

import Builtin
import Swift
import SwiftShims

public class A {
  deinit
  init()
}

public protocol P {
  func foo() -> Int64
}

public class B : A, P {
  public func foo() -> Int64
  deinit
  override init()
}

public class C : A, P {
  public func foo() -> Int64
  deinit
  override init()
}

func imp(x: A & P, y: A & P) -> Int64

public func test(x: B, y: C) -> Int64

sil shared [transparent] [serialized] [thunk] [ossa] @Pfoo : $@convention(witness_method: P) (@in_guaranteed B) -> Int64 {
bb0(%0 : $*B):
  %1 = load_borrow %0
  %2 = class_method %1, #B.foo : (B) -> () -> Int64, $@convention(method) (@guaranteed B) -> Int64
  %3 = apply %2(%1) : $@convention(method) (@guaranteed B) -> Int64
  end_borrow %1
  return %3
}

sil [noinline] [ossa] @foo : $@convention(method) (@guaranteed B) -> Int64 {
bb0(%0 : @guaranteed $B):
  debug_value %0, let, name "self", argno 1
  %2 = integer_literal $Builtin.Int64, 1
  %3 = struct $Int64 (%2)
  return %3
}

// This function calls @impl. The optimizer generates a specialization of impl
// based on the arguments passed to it here. Even though this function isn't
// directly checked, it is essential for the optimization.
// test(x:y:)
sil [ossa] @test :$@convention(thin) (@guaranteed B, @guaranteed C) -> Int64 {
bb0(%0 : @guaranteed $B, %1 : @guaranteed $C):
  debug_value %0, let, name "x", argno 1
  debug_value %1, let, name "y", argno 2
  %3 = copy_value %0
  %5 = init_existential_ref %3 : $B : $B, $A & P
  %6 = copy_value %1
  %7 = init_existential_ref %6 : $C : $C, $A & P
  %8 = function_ref @impl : $@convention(thin) (@guaranteed A & P, @guaranteed A & P) -> Int64
  %9 = apply %8(%5, %7) : $@convention(thin) (@guaranteed A & P, @guaranteed A & P) -> Int64
  destroy_value %7
  destroy_value %5
  return %9
}

// We're looking of an optimized specialization of @impl, not @impl itself.
// CHECK-NOT: @impl
// CHECK-LABEL: sil shared [noinline] @{{.*}}impl{{.*}}
// In the optimization pass we look for uses of alloc_stack (aka %5).
// This test makes sure that we look at the correct uses with the
// correct dominance order (store before apply before dealloc).
// This function will be passed arguments of type B and C for arguments
// %0 and %1 respectively. We want to make sure that we call B's foo method
// and not C's foo method.
sil hidden [noinline] [ossa] @impl : $@convention(thin) (@guaranteed A & P, @guaranteed A & P) -> Int64 {
bb0(%0 : @guaranteed $A & P, %1 : @guaranteed $A & P):
  %2 = open_existential_ref %0 : $A & P to $@opened(1, A & P) Self

  %5 = alloc_stack $@opened(1, A & P) Self
  %6 = store_borrow %2 to %5
  
  // We want to make sure that we picked up on the FIRST store and not the second one.
  // class C's foo method is named "bar" whereas class B's foo method is named "foo".
  // We want to make sure that we call a function named "foo" not "bar".
  // CHECK: [[FN:%[0-9]+]] = function_ref @${{.*}}foo{{.*}} : $@convention(thin) () -> Int64
  %7 = witness_method $@opened(1, A & P) Self, #P.foo : <Self where Self : P> (Self) -> () -> Int64, %2 : $@opened(1, A & P) Self : $@convention(witness_method: P) <τ_0_0 where τ_0_0 : P> (@in_guaranteed τ_0_0) -> Int64
  // CHECK: apply [[FN]]
  %8 = apply %7<@opened(1, A & P) Self>(%6) : $@convention(witness_method: P) <τ_0_0 where τ_0_0 : P> (@in_guaranteed τ_0_0) -> Int64
  
  end_borrow %6
  dealloc_stack %5
  return %8
// CHECK-LABEL: end sil function {{.*}}impl{{.*}}
}

// C.foo()
sil @bar : $@convention(method) (@guaranteed C) -> Int64

sil_vtable [serialized] B {
  #B.foo: (B) -> () -> Int64 : @foo  // B.foo()
}

sil_vtable [serialized] C {
  #C.foo: (C) -> () -> Int64 : @bar
}

sil_witness_table [serialized] B: P module run {
  method #P.foo: <Self where Self : P> (Self) -> () -> Int64 : @Pfoo  // protocol witness for P.foo() in conformance B
}
